#!/usr/bin/env bash
# {{AGENT_DISPLAY_NAME}} telegram-send.sh — Send messages via Telegram
# Usage: ./tools/telegram-send.sh "Your message here"
#        echo "message" | ./tools/telegram-send.sh

set -e

AGENT_DIR="{{AGENT_DIR}}"
AGENT_ENV="$AGENT_DIR/.env"

if [ -f "$AGENT_ENV" ]; then
  set -a; source "$AGENT_ENV"; set +a
fi

if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
  echo "TELEGRAM_BOT_TOKEN not set in .env"
  exit 1
fi
if [ -z "$TELEGRAM_CHAT_ID" ]; then
  echo "TELEGRAM_CHAT_ID not set in .env"
  exit 1
fi

if [ -n "$1" ]; then
  MESSAGE="$1"
elif [ ! -t 0 ]; then
  MESSAGE=$(cat)
else
  echo "Usage: telegram-send.sh 'message' | echo 'msg' | telegram-send.sh"
  exit 1
fi

MAX_LEN=4000
if [ ${#MESSAGE} -gt $MAX_LEN ]; then
  MESSAGE="${MESSAGE:0:$MAX_LEN}..."
fi

RESPONSE=$(/usr/bin/curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
  -d "chat_id=${TELEGRAM_CHAT_ID}" \
  --data-urlencode "text=${MESSAGE}" \
  -d "parse_mode=HTML" 2>&1)

OK=$(echo "$RESPONSE" | jq -r '.ok' 2>/dev/null)
if [ "$OK" = "true" ]; then
  echo "Sent"
else
  echo "Failed: $RESPONSE"
  exit 1
fi
