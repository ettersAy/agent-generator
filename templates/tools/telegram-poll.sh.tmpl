#!/usr/bin/env zsh
# {{AGENT_DISPLAY_NAME}} telegram-poll.sh — Check for new Telegram messages
# Usage: ./tools/telegram-poll.sh [--watch]

set -e

AGENT_DIR="{{AGENT_DIR}}"
AGENT_ENV="$AGENT_DIR/.env"
STATE_FILE="$AGENT_DIR/.telegram-last-update"

if [ -f "$AGENT_ENV" ]; then
  set -a; source "$AGENT_ENV"; set +a
fi

if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
  echo "TELEGRAM_BOT_TOKEN not set in .env"
  exit 1
fi

LAST_UPDATE=0
[ -f "$STATE_FILE" ] && LAST_UPDATE=$(cat "$STATE_FILE")

poll_once() {
  local OFFSET=$((LAST_UPDATE + 1))
  local RESPONSE=$(/usr/bin/curl -s "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getUpdates?offset=${OFFSET}&timeout=5" 2>&1)

  local OK=$(echo "$RESPONSE" | jq -r '.ok' 2>/dev/null)
  if [ "$OK" != "true" ]; then
    echo "API error: $RESPONSE"
    return 1
  fi

  echo "$RESPONSE" | jq -r '.result[] | "\(.update_id)|\(.message.chat.id)|\(.message.from.first_name // "Unknown")|\(.message.text // "[non-text]")"' 2>/dev/null | while IFS='|' read -r UPDATE_ID CHAT_ID FROM TEXT; do
    if [ -n "$UPDATE_ID" ] && [ "$UPDATE_ID" -gt "$LAST_UPDATE" ] 2>/dev/null; then
      echo "[${FROM}] ${TEXT}"
      LAST_UPDATE=$UPDATE_ID
      echo "$LAST_UPDATE" > "$STATE_FILE"

      if [ -z "$TELEGRAM_CHAT_ID" ] && [ -n "$CHAT_ID" ]; then
        echo ""
        echo "Detected chat ID: $CHAT_ID"
        echo "   Add this to .env: TELEGRAM_CHAT_ID=$CHAT_ID"
      fi
    fi
  done
}

case "${1:-}" in
  --watch)
    echo "Watching for Telegram messages (Ctrl+C to stop)..."
    while true; do
      poll_once
      sleep 3
    done
    ;;
  *)
    poll_once
    ;;
esac
